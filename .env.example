# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
# Modern publishable key (preferred). Used by lib/supabase-server.ts as primary,
# and by lib/supabase.ts as fallback when NEXT_PUBLIC_SUPABASE_ANON_KEY is absent.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Legacy anon key (optional). Used by lib/supabase.ts as primary if present.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Web Push (PWA lock-screen alerts on Android Chrome and iOS Home Screen)
# Generate a key pair: npx web-push generate-vapid-keys
# Generate the dispatch secret: openssl rand -hex 32
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=https://pgcv-bioinformatics-dashboard.vercel.app
PUSH_DISPATCH_SECRET=your-push-dispatch-secret-here

# Add any additional environment variables below:
