# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
# Modern publishable key (preferred). Used by lib/supabase-server.ts as primary,
# and by lib/supabase.ts as fallback when NEXT_PUBLIC_SUPABASE_ANON_KEY is absent.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Legacy anon key (optional). Used by lib/supabase.ts as primary if present.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Web Push (PWA lock-screen alerts on Android Chrome and iOS Home Screen)
# Generate a key pair: npx web-push generate-vapid-keys
# Generate the dispatch secret: openssl rand -hex 32
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=https://pgcv-bioinformatics-dashboard.vercel.app
PUSH_DISPATCH_SECRET=your-push-dispatch-secret-here
# Optional. Vercel sets CRON_SECRET on production. Either secret authorizes
# GET /api/cron/task-reminders (daily 00:05 Asia/Manila).

# Training module library (private GitHub repo, read server-side only).
# Fine-grained PAT: Repository access = only bioinfo-modules,
# Permissions = Contents: Read-only. Rotating it also expires open module links.
GITHUB_MODULES_TOKEN=your-github-fine-grained-token-here
# Optional overrides (defaults shown)
# GITHUB_MODULES_REPO=bioinfopgcupvisayas/bioinfo-modules
# GITHUB_MODULES_REF=main

# Lab Tour content (private pgcv-tour-content repo, read server-side only).
# Optional: falls back to GITHUB_MODULES_TOKEN when that PAT can read the repo.
# GITHUB_TOUR_TOKEN=your-github-fine-grained-token-here
# GITHUB_TOUR_REPO=bioinfopgcupvisayas/pgcv-tour-content
# GITHUB_TOUR_REF=main

# Add any additional environment variables below:
